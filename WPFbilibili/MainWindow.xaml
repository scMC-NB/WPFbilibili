<Window x:Class="WPFbilibili.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bilibili 客户端" Height="900" Width="1400" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" Background="{DynamicResource AppBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F7F8"/>
        <SolidColorBrush x:Key="SideBarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18191C"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9499A0"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F1F2F3"/>
        <SolidColorBrush x:Key="PinkBrush" Color="#FB7299"/>
        <SolidColorBrush x:Key="PinkHoverBrush" Color="#E9628A"/>
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#E0E0E0"/>

        <Style TargetType="RadioButton" x:Key="NavRadioStyle">
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="Indicator" Width="4" Height="24" CornerRadius="2" Background="{StaticResource PinkBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowButtonStyle">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CloseButtonStyle" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PinkButtonStyle">
            <Setter Property="Background" Value="{StaticResource PinkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PinkHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider" x:Key="BiliSlider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#444444" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource PinkBrush}" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource PinkBrush}" Stroke="White" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="VideoCardTemplate">
            <Border Width="260" Height="235" Margin="0,0,16,16" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="VideoCard_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="146"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource HoverBackgroundBrush}">
                            <Image Source="{Binding PicUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <Border VerticalAlignment="Bottom" Height="32" CornerRadius="0,0,8,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#99000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▶" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding PlayCount}" Foreground="White" FontSize="11"/>
                                    <TextBlock Text="💬" Foreground="White" FontSize="10" Margin="12,0,4,0"/>
                                    <TextBlock Text="{Binding DanmakuCount}" Foreground="White" FontSize="11"/>
                                </StackPanel>
                                <Border Background="#80000000" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Author}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource SideBarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Center" Margin="0,18,0,20">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/app.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavRadioStyle}" Click="BtnNavHome_Click" IsChecked="True">
                    <StackPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="首页" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavRank" Style="{StaticResource NavRadioStyle}" Click="BtnNavRank_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="排行" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavLive" Style="{StaticResource NavRadioStyle}" Click="BtnNavLive_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="直播" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavMine" Style="{StaticResource NavRadioStyle}" Click="BtnMyProfile_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock Text="我的" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,15" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtLocalVersion" Text="v Beta" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <Button x:Name="BtnCheckUpdate" Content="检查更新" FontSize="11" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource PinkBrush}" Click="BtnCheckUpdate_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="60" Margin="24,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="TxtSearch" Width="300" Height="36" Padding="12,0" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Tag="搜索或输入BV号..."/>
                    <Button Content="搜索" Width="60" Height="36" Margin="8,0,0,0" Background="{StaticResource PinkBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSearch_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnLogin" Content="登录" Width="70" Height="36" Margin="16,0,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" Click="BtnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClick">
                        <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick">
                        <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,10,24,24">

                <ScrollViewer x:Name="ListViewer" VerticalScrollBarVisibility="Auto" ScrollChanged="ListScrollViewer_ScrollChanged" Background="{DynamicResource AppBackgroundBrush}">
                    <StackPanel>
                        <StackPanel x:Name="LiveCategoryPanel" Orientation="Horizontal" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock Text="分区筛选：" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource PinkBrush}" Margin="0,0,12,0"/>
                            <Button Content="网游" Width="64" Height="32" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" Cursor="Hand" Click="BtnLiveCategory_Click" Tag="2"/>
                            <Button Content="手游" Width="64" Height="32" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" Cursor="Hand" Click="BtnLiveCategory_Click" Tag="3"/>
                            <Button Content="单机" Width="64" Height="32" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" Cursor="Hand" Click="BtnLiveCategory_Click" Tag="6"/>
                            <Button Content="知识" Width="64" Height="32" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" Cursor="Hand" Click="BtnLiveCategory_Click" Tag="36"/>
                            <Button Content="虚拟" Width="64" Height="32" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" Cursor="Hand" Click="BtnLiveCategory_Click" Tag="9"/>
                        </StackPanel>

                        <ItemsControl x:Name="VideoGrid" ItemTemplate="{StaticResource VideoCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="TxtLoading" Text="加载中..." HorizontalAlignment="Center" Margin="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="SpaceView" Visibility="Collapsed" Background="{DynamicResource AppBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button Content="⬅ 返回列表" HorizontalAlignment="Left" Padding="10,6" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand" Click="BtnBackFromSpace_Click" Margin="0,0,0,10"/>

                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="80" Height="80" Margin="0,0,20,0">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ImgSpaceAvatar" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSpaceName" Text="UP主名字" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtSpaceSign" Text="UP主简介" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock x:Name="TxtSpaceFans" Text="粉丝数: -" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,20,0"/>
                                            <TextBlock x:Name="TxtSpaceView" Text="总播放: -" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="他的投稿" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="SpaceVideoGrid" ItemTemplate="{StaticResource VideoCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="TxtSpaceLoading" Text="加载空间视频中..." HorizontalAlignment="Center" Margin="20" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PlayView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border CornerRadius="12" Background="Black" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="520"/>
                                        <RowDefinition Height="48"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <vlc:VideoView x:Name="VideoView">
                                            <Grid>
                                                <Canvas x:Name="DanmakuCanvas" IsHitTestVisible="False" ClipToBounds="True" Background="Transparent"/>
                                            </Grid>
                                        </vlc:VideoView>

                                        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                                Width="36" Height="36" Background="#80000000" Foreground="White" 
                                                BorderThickness="0" Cursor="Hand" Click="BtnBackToList_Click" Panel.ZIndex="2">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <Border Grid.Row="1" Background="#1E1E1E">
                                        <Grid Margin="16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="BtnPlayPause" Grid.Column="0" Content="▶" Width="32" Height="32" FontSize="16" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnPlayPause_Click"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtTime" Text="00:00 / 00:00" Foreground="#CCCCCC" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="12,0,16,0"/>

                                            <Slider x:Name="SliderProgress" Grid.Column="2" Style="{StaticResource BiliSlider}" VerticalAlignment="Center" Minimum="0" Maximum="1" Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted" ValueChanged="Slider_ValueChanged"/>

                                            <CheckBox x:Name="ChkDanmakuEnabled" Grid.Column="3" Content="弹幕" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True" Checked="ChkDanmakuEnabled_Checked" Unchecked="ChkDanmakuEnabled_Unchecked"/>

                                            <ComboBox x:Name="CmbSpeed" Grid.Column="4" Width="70" Height="26" SelectedIndex="2" SelectionChanged="CmbSpeed_SelectionChanged" Margin="16,0,0,0" Background="#333333" Foreground="White" BorderThickness="0">
                                                <ComboBoxItem Content="0.5x"/>
                                                <ComboBoxItem Content="0.75x"/>
                                                <ComboBoxItem Content="1.0x"/>
                                                <ComboBoxItem Content="1.25x"/>
                                                <ComboBoxItem Content="1.5x"/>
                                                <ComboBoxItem Content="2.0x"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="4,20,4,0">
                                <TextBlock x:Name="DetailTitle" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Ellipse Width="38" Height="38" Fill="{DynamicResource HoverBackgroundBrush}" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="DetailAuthor" FontSize="15" FontWeight="Bold" Foreground="#00A1D6" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="DetailAuthor_Click"/>
                                </StackPanel>
                                <Border Margin="0,16,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <TextBlock x:Name="DetailDesc" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22"/>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDanmakuInput" Grid.Column="0" Height="40" Padding="12,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Tag="发个弹幕见证当下..." VerticalContentAlignment="Center"/>
                                <ComboBox x:Name="CmbDanmakuColor" Grid.Column="1" Width="90" Height="40" Margin="10,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}">
                                    <ComboBoxItem Content="白色" Tag="16777215"/>
                                    <ComboBoxItem Content="红色" Tag="16711680"/>
                                    <ComboBoxItem Content="橙色" Tag="16750592"/>
                                    <ComboBoxItem Content="黄色" Tag="16776960"/>
                                    <ComboBoxItem Content="绿色" Tag="65280"/>
                                    <ComboBoxItem Content="蓝色" Tag="255"/>
                                    <ComboBoxItem Content="紫色" Tag="9117103"/>
                                    <ComboBoxItem Content="粉色" Tag="16476622"/>
                                </ComboBox>
                                <Button x:Name="BtnSendDanmaku" Grid.Column="2" Content="发送弹幕" Style="{StaticResource PinkButtonStyle}" Margin="10,0,0,0" Click="BtnSendDanmaku_Click"/>
                            </Grid>

                            <Border Margin="0,20,0,0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" x:Name="TxtCommentHeader" Text="热门评论" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                    <Grid Grid.Row="1" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCommentInput" Grid.Column="0" Height="40" Padding="12,0" Background="{DynamicResource InputBackgroundBrush}" BorderThickness="0" Tag="发一条友善的评论..." VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnSendComment" Grid.Column="1" Content="发送评论" Style="{StaticResource PinkButtonStyle}" Margin="10,0,0,0" Click="BtnSendComment_Click"/>
                                    </Grid>

                                    <ListBox x:Name="CommentList" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="CommentList_ScrollChanged"
                                             MaxHeight="400">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,10"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource PinkBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                                Visibility="{Binding IsTop, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="置顶" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding UserName}" Foreground="#00A1D6" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22"/>
                                                    <TextBlock Text="{Binding LikeInfo}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Button x:Name="BtnLoadMoreComments" Grid.Row="3" Content="加载更多..." HorizontalAlignment="Center"
                                            Margin="0,16,0,0" Padding="16,6" Background="Transparent" BorderThickness="0"
                                            Foreground="#00A1D6" FontSize="14" Cursor="Hand" Click="BtnLoadMoreComments_Click" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
